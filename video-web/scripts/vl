#!/usr/bin/env bash
# vl — único punto de entrada de la skill video-web.
# Se corre desde la carpeta del proyecto como ./vl (vl init crea ese enlace).
# Herramientas independientes: cada comando revisa solo sus propios insumos. El orden del
# trabajo lo decide el modelo; `./vl estado` dice qué hay hecho según los archivos.
set -uo pipefail

VL_SELF="$(readlink -f "${BASH_SOURCE[0]}")"
S="$(dirname "$VL_SELF")"
SKILL="$(dirname "$S")"
# Rutas propias de la máquina (venvs, biblioteca de voces, sandbox de Chrome): fuera del repo.
ENTORNO="${XDG_CONFIG_HOME:-$HOME/.config}/video-web/entorno.sh"
# shellcheck source=/dev/null
[[ -f "$ENTORNO" ]] && source "$ENTORNO"
# El primer intérprete que tenga las dependencias. `VL_PY` manda si está definido; si no,
# se buscan los venv habituales antes del python del sistema (que casi nunca las tiene).
elegir_py() {
  local c
  for c in "${VL_PY:-}" "${VIRTUAL_ENV:-}/bin/python3" "$PWD/.venv/bin/python3" \
           "$HOME/.venv/bin/python3" "$HOME/.venvs/video-web/bin/python3" \
           "$(command -v python3)"; do
    [[ -x "$c" ]] || continue
    "$c" -c "import playwright, PIL, numpy" 2> /dev/null && { echo "$c"; return; }
  done
  echo "${VL_PY:-$(command -v python3)}"  # que falle con el mensaje de `vl doctor`
}
PY="$(elegir_py)"
QWEN="${VL_QWEN_VENV:-$HOME/.venvs/qwen-tts}"
VOCES="${VL_VOCES:-$HOME/.config/video-web/voces}"
HF_HUB="${HF_HOME:-$HOME/.cache/huggingface}/hub"
export PYTHONPATH="$S${PYTHONPATH:+:$PYTHONPATH}" VL_QWEN_VENV="$QWEN" VL_VOCES="$VOCES"

die() { echo "✗ $*" >&2; exit 1; }
chk() { "$PY" "$S/checks.py" "$@"; }
gm_version() { sed -n 's/.*"givemotion": *"\([0-9.]*\)".*/\1/p' "$SKILL/compat.json"; }
# Versión fijada: givemotion es joven (0.1.x) y una actualización puede cambiar su API.
gm() { npx --yes "givemotion@$(gm_version)" "$@"; }

# Tareas largas (voz, música, render) en segundo plano: sobreviven al límite de tiempo del
# agente. `./vl esperar NOMBRE` espera de a poco y muestra el final del log.
# GPU compartida: voz y render toman un candado (flock) y comprueban memoria libre antes de
# empezar, para que dos proyectos no se pisen la GPU y mueran a medias con «out of memory».
# VL_GPU_LOCK cambia el archivo del candado; VL_GPU_MIN_MIB (4000) la memoria mínima libre;
# VL_GPU_ESPERA_S (3600) cuánto esperar el turno; VL_DEVICE=cpu salta ambas comprobaciones.
gpu_memoria() {  # MiB libres de la primera GPU NVIDIA; vacío si no hay
  nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits 2> /dev/null | head -1 | tr -d ' '
}
gpu_listo() {
  [[ "${VL_DEVICE:-}" == cpu ]] && return 0
  local free min="${VL_GPU_MIN_MIB:-4000}"
  free="$(gpu_memoria)"
  [[ "$free" =~ ^[0-9]+$ ]] || return 0  # sin GPU NVIDIA: corre en CPU/MPS, nada que cuidar
  ((free >= min)) && return 0
  echo "✗ la GPU tiene ${free} MiB libres y hacen falta ${min}. Otro proceso la está usando:" >&2
  nvidia-smi --query-compute-apps=pid,used_memory,name --format=csv,noheader >&2 2> /dev/null
  echo "  Espera a que termine o ciérralo y repite (VL_GPU_MIN_MIB cambia el mínimo; VL_DEVICE=cpu corre sin GPU)." >&2
  return 1
}
gpu_candado() {  # toma el candado en el descriptor 9; vive hasta que termina el proceso
  [[ "${VL_DEVICE:-}" == cpu ]] && return 0
  command -v flock > /dev/null || { echo "⚠ sin flock: sin candado de GPU" >&2; return 0; }
  local lock="${VL_GPU_LOCK:-${XDG_CACHE_HOME:-$HOME/.cache}/video-web/gpu.lock}"
  mkdir -p "$(dirname "$lock")"
  exec 9> "$lock"
  flock -n 9 && return 0
  echo "⏳ la GPU está en uso por otro video (candado $lock); esperando turno…" >&2
  flock -w "${VL_GPU_ESPERA_S:-3600}" 9 ||
    { echo "✗ la GPU sigue ocupada tras ${VL_GPU_ESPERA_S:-3600} s: otro video la tiene (candado $lock)." >&2; return 1; }
}

if [[ "${1:-}" == _run ]]; then
  name="$2"; shift 2
  if [[ "${VL_GPU:-}" == 1 ]] && ! { gpu_candado && gpu_listo; }; then
    echo 1 > ".vl/tareas/$name.estado"; exit 0
  fi
  "$@"; echo $? > ".vl/tareas/$name.estado"; exit 0
fi

bg() {
  local name="$1"; shift
  mkdir -p .vl/tareas
  [[ "$(cat ".vl/tareas/$name.estado" 2>/dev/null)" == corriendo ]] &&
    die "'$name' ya está corriendo: ./vl esperar $name"
  echo corriendo > ".vl/tareas/$name.estado"
  # setsid no existe en macOS: nohup basta para sobrevivir al fin del agente
  VL_GPU="${GPU:-}" $(command -v setsid || echo nohup) "$VL_SELF" _run "$name" "$@" > ".vl/tareas/$name.log" 2>&1 < /dev/null &
  echo "⏳ '$name' corre en segundo plano (log: .vl/tareas/$name.log)"
  echo "SIGUIENTE: ./vl esperar $name"
}

cmd_esperar() {
  local name="${1:?uso: ./vl esperar voz|render}" max="${VL_ESPERA_S:-100}" t=0
  local st=".vl/tareas/$name.estado"
  [[ -f "$st" ]] || die "no hay tarea '$name'"
  # ponytail: espera corta y repetible; el agente vuelve a llamar si sigue corriendo
  while [[ "$(cat "$st")" == corriendo && $t -lt $max ]]; do sleep 5; t=$((t + 5)); done
  tail -n 20 ".vl/tareas/$name.log"
  local code; code="$(cat "$st")"
  if [[ "$code" == corriendo ]]; then
    echo "⏳ '$name' sigue corriendo."; echo "SIGUIENTE: ./vl esperar $name"; return 0
  fi
  [[ "$code" == 0 ]] && echo "✅ '$name' terminó." ||
    echo "✗ '$name' terminó con error ($code): lee .vl/tareas/$name.log"
  return "$code"
}

cmd_doctor() {
  local bad=0
  ok() { echo "✓ $1"; }
  ko() { echo "✗ $1"; bad=1; }
  warn() { echo "⚠ $1"; }
  command -v node > /dev/null && ok "node $(node --version)" || ko "node (instala Node ≥ 20)"
  for b in npx ffmpeg ffprobe; do command -v "$b" > /dev/null && ok "$b" || ko "$b"; done
  command -v pdftotext > /dev/null && ok pdftotext || warn "pdftotext (opcional, poppler-utils)"
  [[ -f "$ENTORNO" ]] && ok "entorno local $ENTORNO" || warn "sin $ENTORNO (rutas por omisión)"
  "$PY" -c "import playwright, PIL, numpy" 2> /dev/null && ok "venv general $PY" ||
    ko "venv general $PY sin playwright/Pillow/numpy (define VL_PY en $ENTORNO)"
  ls "$HOME/.cache/ms-playwright" 2> /dev/null | grep -q '^chromium' && ok "chromium de Playwright" ||
    ko "chromium de Playwright: $PY -m playwright install chromium"
  "$QWEN/bin/python" -c "import qwen_tts, faster_whisper, librosa, soundfile" > /dev/null 2>&1 &&
    ok "venv TTS $QWEN" || ko "venv TTS: corre ./vl setup-tts"
  for m in Qwen--Qwen3-TTS-12Hz-1.7B-Base Qwen--Qwen3-TTS-12Hz-1.7B-VoiceDesign \
    Systran--faster-whisper-large-v3; do
    [[ -d "$HF_HUB/models--$m" ]] && ok "modelo $m" || warn "modelo $m: se descarga en el primer uso"
  done
  ok "voces de la skill: $(ls "$SKILL/assets/voces" 2> /dev/null | tr '\n' ' ')"
  local voces
  voces="$(ls "$VOCES" 2> /dev/null | tr '\n' ' ')"
  [[ -n "$voces" ]] && ok "voces propias en $VOCES: $voces" ||
    echo "· sin voces propias en $VOCES (opcional: ./vl voz design y ./vl voz guardar)"
  local free
  free="$(nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits 2> /dev/null | head -1)"
  if [[ -z "$free" ]]; then
    warn "sin GPU NVIDIA: voz en CPU/MPS (≈ 6× la duración del audio con 16 núcleos; 10 GB de RAM)"
  elif ((free < 6000)); then warn "GPU con ${free} MiB libres: cierra otros procesos que usen la GPU"
  else ok "GPU con ${free} MiB libres"; fi
  echo "video-web $(cat "$SKILL/VERSION") · givemotion@$(gm_version)"
  if gm doctor > /tmp/vl-gm-doctor.txt 2>&1; then ok "givemotion doctor"
  else ko "givemotion doctor (ver /tmp/vl-gm-doctor.txt)"; fi
  # Sin user namespaces, Chrome muere con SIGTRAP y el mensaje no dice cómo arreglarlo.
  [[ "$(uname)" == Linux && -z "${GIVEMOTION_NO_SANDBOX:-}" ]] &&
    [[ "$(cat /proc/sys/kernel/apparmor_restrict_unprivileged_userns 2> /dev/null)" == 1 ]] &&
    warn "Chrome sin sandbox disponible: agrega 'export GIVEMOTION_NO_SANDBOX=1' a $ENTORNO"
  ((bad)) && echo "SIGUIENTE: corrige los ✗ y repite ./vl doctor" ||
    echo "SIGUIENTE: ./vl init <ruta-sin-espacios> [--manual manual.pdf]"
  return "$bad"
}

cmd_setup_tts() {
  if "$QWEN/bin/python" -c "import qwen_tts, faster_whisper, librosa, soundfile" > /dev/null 2>&1; then
    echo "✓ venv TTS listo: $QWEN"; return 0
  fi
  # ponytail: instalación guiada, no automática (PyTorch CUDA depende del equipo)
  cat << EOF
✗ falta el venv de TTS ($QWEN). Pide al usuario que lo cree una vez (≈ 6 GB):
  uv venv "$QWEN" --python 3.12
  uv pip install --python "$QWEN/bin/python" torch qwen-tts faster-whisper librosa soundfile transformers
Si la ruta es otra, ponla en $ENTORNO: export VL_QWEN_VENV=/ruta
Luego: ./vl doctor
EOF
  return 1
}

ROUTING='<!-- vl:ruteo -->
# Proyecto de la skill video-web

Este video se construye con la skill `video-web` y su comando `./vl`.
Al retomar: corre `./vl estado` (qué hay hecho) y lee la skill. Las escenas son givemotion:
lee también `.claude/skills/givemotion/SKILL.md`. Nunca navegues la app del cliente con MCP,
Playwright ni el navegador: `./vl explorar` y `./vl captura` lo hacen en solo lectura.
<!-- /vl:ruteo -->'

cmd_init() {
  local dir="${1:?uso: vl init <ruta-del-proyecto> [--manual manual.pdf]}" manual=""
  [[ "${2:-}" == --manual ]] && manual="$(readlink -f "${3:?falta el PDF}")"
  [[ "$dir" == *" "* ]] && die "la ruta tiene espacios (ffmpeg y givemotion fallan): usa otra"
  mkdir -p "$dir" || die "no pude crear $dir"
  if [[ ! -d "$dir/.claude/skills/givemotion" ]]; then
    (cd "$dir" && gm skill > /dev/null) || die "falló givemotion skill (¿npx sin red?)"
  fi
  cd "$dir" || die "no pude entrar a $dir"
  ln -sfn "$VL_SELF" vl
  mkdir -p scenes assets/voice assets/fonts assets/sfx assets/bgm renders .vl
  # credenciales opcionales en .env: nunca al repositorio
  grep -qx '.env' .gitignore 2> /dev/null || echo '.env' >> .gitignore
  for f in BRIEF.md capture.json audio.json SCRIPT.md; do
    [[ -f "$f" ]] || cp "$SKILL/assets/templates/$f" .
  done
  [[ -f video.html ]] || cp "$SKILL/assets/templates/givemotion/video.html" .
  [[ -f escenas.css ]] || cp "$SKILL/assets/templates/escenas.css" .
  # Efectos de sonido con licencia comercial (Pixabay) de media-use, si está instalada
  local sfx="${VL_SFX_DIR:-$HOME/.agents/skills/media-use/audio/assets/sfx}"
  if [[ -d "$sfx" ]] && ! ls assets/sfx/*.mp3 > /dev/null 2>&1; then
    cp "$sfx"/*.mp3 "$sfx/CREDITS.md" assets/sfx/ 2> /dev/null && echo "✓ efectos de sonido en assets/sfx/"
  fi
  # Voz por omisión de la máquina (entorno.sh → VL_VOZ): sin diseñar una nueva por proyecto
  if [[ -n "${VL_VOZ:-}" ]]; then
    "$PY" -c 'import json,sys;p="audio.json";c=json.load(open(p,encoding="utf-8"))
c["voice"]["library"]=c["voice"].get("library") or sys.argv[1]
open(p,"w",encoding="utf-8").write(json.dumps(c,ensure_ascii=False,indent=2)+"\n")' "$VL_VOZ"
    echo "✓ voz de la biblioteca: $VL_VOZ"
  fi
  grep -qx 'renders/' .gitignore 2> /dev/null || printf 'renders/\n.vl/\n' >> .gitignore
  for f in AGENTS.md CLAUDE.md; do
    grep -q 'vl:ruteo' "$f" 2> /dev/null && continue
    { printf '%s\n\n' "$ROUTING"; cat "$f" 2> /dev/null || true; } > "$f.vl" && mv "$f.vl" "$f"
  done
  if [[ -n "$manual" ]]; then
    pdftotext -layout "$manual" manual.txt && echo "✓ manual → manual.txt ($(wc -l < manual.txt) líneas)"
    # Las capturas del manual se recortan de sus páginas: `./vl crop --src capture/manual/…`
    if command -v pdftoppm > /dev/null; then
      mkdir -p capture/manual && pdftoppm -r 220 -png "$manual" capture/manual/pagina &&
        echo "✓ páginas → capture/manual/ ($(ls capture/manual | wc -l) imágenes; recorta con ./vl crop)"
    fi
  fi
  echo "✅ proyecto listo en $PWD"
  echo "SIGUIENTE: cd $PWD; explora la app (./vl explorar), completa BRIEF.md y capture.json"
  echo "  (references/captura.md). 🛑 Pregunta al usuario si los datos de la app son de prueba."
}

cmd_musica() {
  local pista="${1:?uso: ./vl musica <pista con licencia comercial> [--licencia \"texto\"]}" lic=""
  [[ "${2:-}" == --licencia ]] && lic="${3:-}"
  [[ -f "$pista" ]] || die "no existe $pista"
  [[ -n "$lic" ]] || die "falta --licencia: de dónde sale la pista y qué licencia tiene (CC0, \
licencia de Artlist…). MusicGen es no comercial y ya no se usa: un curso de pago es uso comercial."
  mkdir -p assets/bgm
  cp "$pista" "assets/bgm/${pista##*/}"
  "$PY" - "assets/bgm/${pista##*/}" "$lic" << 'EOF'
import json, sys
from pathlib import Path
cfg = json.loads(Path("audio.json").read_text(encoding="utf-8"))
bgm = cfg.get("bgm") or {}
bgm.update(path=sys.argv[1], licencia=sys.argv[2])
bgm.pop("prompt", None)
cfg["bgm"] = bgm
Path("audio.json").write_text(json.dumps(cfg, ensure_ascii=False, indent=2), encoding="utf-8")
with Path("CREDITOS.md").open("a", encoding="utf-8") as out:
    out.write(f"- Música: {Path(sys.argv[1]).name} — {sys.argv[2]}\n")
EOF
  echo "✅ música: assets/bgm/${pista##*/} (anotada en CREDITOS.md)"
  echo "SIGUIENTE: la mezcla se hace en ./vl final (baja con la voz, sube en audio.json → bgm.secciones)"
}

cmd_revisar() {
  mkdir -p .vl renders/review
  gm check video.html --json > .vl/check.json 2> .vl/check.err
  gm check video.html 2>&1 | tail -n 25
  gm snapshot video.html -o renders/review 2>&1 | tail -n 3
  # un cuadro al 65 % de cada escena (ya armada): las hojas automáticas pueden caer en su
  # inicio, vacío. `check escenas` mide en ellos cuánto lienzo usa cada una.
  local t; gm inspect video.html > .vl/inspect.json 2> /dev/null; t="$(chk tiempos)"
  rm -rf renders/review/escenas
  [[ -n "$t" ]] && gm snapshot video.html --times "$t" -o renders/review/escenas > /dev/null 2>&1 &&
    echo "✓ un cuadro por escena en renders/review/escenas/ (al 65 % de cada una)"
  chk escenas
  echo "SIGUIENTE: mira TÚ las hojas de renders/review (lista en references/oficio.md § Revisión);"
  echo "  para un momento exacto: npx givemotion@$(gm_version) still video.html -t 12.3 -o f.png"
}

cmd="${1:-estado}"
shift || true
case "$cmd" in
  doctor) cmd_doctor ;;
  setup-tts) cmd_setup_tts ;;
  init) cmd_init "$@" ;;
  estado) chk estado ;;
  check) chk "${1:-todo}" ;;
  explorar) "$PY" "$S/capture.py" explorar --route "${1:?uso: ./vl explorar /ruta [--auth]}" "${@:2}" ;;
  captura) "$PY" "$S/capture.py" run "$@" ;;
  crop) "$PY" "$S/capture.py" crop "$@" ;;
  medir) "$PY" "$S/capture.py" medir --route "${1:?uso: ./vl medir /ruta --texto \"Nombre\" [--ancho 1240]}" "${@:2}" ;;
  marca)
    if [[ "${1:-}" == sugerir ]]; then "$PY" "$S/brand.py" sugerir "${@:2}"
    else "$PY" "$S/brand.py" aplicar "$@"; fi ;;
  voz)
    [[ "${1:-}" =~ ^(design|lines|finalize|guardar)$ ]] ||
      die "uso: ./vl voz design|lines [--frames 3,7]|finalize|guardar <nombre>"
    [[ "$1" == guardar ]] && { "$QWEN/bin/python" "$S/voice.py" "$@"; exit $?; }
    GPU=1 bg voz "$QWEN/bin/python" "$S/voice.py" "$@" ;;
  musica) cmd_musica "$@" ;;
  revisar) cmd_revisar ;;
  gpu) gpu_listo && echo "✓ GPU lista (o sin GPU NVIDIA)" ;;
  gm) gm "$@" ;;
  render)
    # CRF 16: las plataformas de cursos recodifican; el original debe llegar limpio
    GPU=1 bg render npx --yes "givemotion@$(gm_version)" render video.html -o renders/imagen-voz.mp4 \
      --crf 16 ;;
  final) "$PY" "$S/final.py" "$@" && chk entrega ;;
  esperar) cmd_esperar "$@" ;;
  *) die "comando desconocido '$cmd'. Comandos: doctor setup-tts init estado check explorar
  captura crop medir marca voz musica revisar render final esperar gpu gm" ;;
esac
